<Window x:Class="Qingying.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:core="clr-namespace:Qingying.Core;assembly=Qingying.Core"
        Title="轻影播放器"
        Width="1120"
        Height="700"
        MinWidth="1080"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Bg0}"
        Icon="Assets/qingying.ico"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Storyboard x:Key="DiscSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="DiscRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:10"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Bg1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Width="22" Height="22" Margin="12,0,8,0" Source="Assets/qingying.ico" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="轻影" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleFile" Grid.Column="2" Margin="16,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Text="本地影音播放器"/>
            <TextBlock x:Name="TitleStatus" Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" FontSize="12" Text="就绪"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE949;" Click="Minimize_Click" ToolTip="最小化"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE739;" Click="Maximize_Click" ToolTip="最大化"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SplitColumn" Width="4"/>
                <ColumnDefinition x:Name="PlaylistColumn" Width="320"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="Stage" Background="#050608"
                  MouseLeftButtonDown="Stage_MouseLeftButtonDown">
                <vlc:VideoView x:Name="VideoSurface" Visibility="Collapsed">
                    <Grid x:Name="VideoHitTarget" Background="#01000000"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          MouseLeftButtonDown="Stage_MouseLeftButtonDown"
                          MouseRightButtonUp="Stage_MouseRightButtonUp"/>
                </vlc:VideoView>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="92" Height="92" CornerRadius="46" Background="#1A2230" HorizontalAlignment="Center">
                        <Path Data="M34,24 L68,46 L34,68 Z" Fill="#FF7A18" Stretch="Uniform" Margin="24"/>
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Margin="0,18,0,0" FontSize="20" HorizontalAlignment="Center" Text="把影片拖到这里"/>
                    <TextBlock x:Name="EmptySubtitle" Margin="0,8,0,0" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                               Text="支持 MP4、MKV、AVI、MOV、FLV、RMVB、MP3、FLAC 等常见格式"/>
                    <Button Margin="0,18,0,0" Style="{StaticResource TextButton}" Content="打开文件" Click="OpenFiles_Click" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="AudioState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="180" Height="180" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Fill="#1A140E" Stroke="#FF7A18" StrokeThickness="8"/>
                        <Ellipse x:Name="DiscRing" Width="70" Height="70" Fill="#0C0E13" Stroke="#FFB15A" StrokeThickness="3"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="AudioTitle" Margin="0,18,0,0" FontSize="18" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Text="正在播放音频"/>
                </StackPanel>
            </Grid>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#1A2030"/>

            <DockPanel x:Name="PlaylistPanel" Grid.Column="2" Background="{StaticResource Bg1}">
                <Grid DockPanel.Dock="Top" Margin="16,14,16,8">
                    <TextBlock Text="播放列表" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PlaylistCount" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="0"/>
                </Grid>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,12,12">
                    <Button Style="{StaticResource TextButton}" Content="添加" Click="OpenFiles_Click" ToolTip="添加文件"/>
                    <Button Style="{StaticResource TextButton}" Content="文件夹" Click="OpenFolder_Click" Margin="6,0,0,0"/>
                    <Button Style="{StaticResource TextButton}" Content="移除" Click="Remove_Click" Margin="6,0,0,0" ToolTip="移除选中项"/>
                    <Button Style="{StaticResource TextButton}" Content="清空" Click="Clear_Click" Margin="6,0,0,0"/>
                </StackPanel>
                <Grid x:Name="PlaylistHost">
                    <TreeView x:Name="PlaylistView" Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource Text}"
                              AllowDrop="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseLeftButtonDown="Playlist_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="Playlist_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="Playlist_PreviewMouseLeftButtonUp"
                              DragOver="Playlist_DragOver"
                              DragLeave="Playlist_DragLeave"
                              Drop="Playlist_Drop">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <EventSetter Event="MouseDoubleClick" Handler="PlaylistItem_DoubleClick"/>
                                <Style.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F3F6FA"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F3F6FA"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2A3344"/>
                                </Style.Resources>
                            </Style>
                            <HierarchicalDataTemplate DataType="{x:Type core:PlaylistNode}" ItemsSource="{Binding Children}">
                                <Border Padding="4,3" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#3A2A1C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="Background" Value="#2A3344"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Width="16" VerticalAlignment="Center" Foreground="#FF7A18"
                                                   Text="&#xE8B7;"
                                                   Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Width="16" VerticalAlignment="Center" Foreground="#FF7A18"
                                                   Text="&#xE768;"
                                                   Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Extension}" Margin="8,0,0,0" Foreground="#93A0B5" FontSize="11" VerticalAlignment="Center"
                                                   Visibility="{Binding IsFolder, Converter={StaticResource InverseBooleanToVisibility}}"/>
                                    </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <TextBlock x:Name="EmptyPlaylist" Text="把文件夹拖到这里，会按文件夹收起" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="16"
                               IsHitTestVisible="False"/>
                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="DropLine" Height="2" Background="#FF7A18" CornerRadius="1" Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </DockPanel>
        </Grid>

        <Border x:Name="ErrorBanner" Grid.Row="2" Background="#3A2220" Padding="16,8" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="#FFB4A8" TextWrapping="Wrap"/>
        </Border>

        <Border x:Name="ImagePanel" Grid.Row="3" Background="#171C26" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,16,6">
                    <TextBlock Text="亮度" Width="36" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="BrightnessValue" Width="36" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="ImageSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Grid.Column="1" Margin="0,0,16,6">
                    <TextBlock Text="对比" Width="36" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="ContrastValue" Width="36" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <Slider x:Name="ContrastSlider" Minimum="0" Maximum="2" Value="1" ValueChanged="ImageSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,0,16,0">
                    <TextBlock Text="饱和" Width="36" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="SaturationValue" Width="36" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <Slider x:Name="SaturationSlider" Minimum="0" Maximum="3" Value="1" ValueChanged="ImageSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="伽马" Width="36" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="GammaValue" Width="36" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <Slider x:Name="GammaSlider" Minimum="0.2" Maximum="3" Value="1" ValueChanged="ImageSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,16,0">
                    <TextBlock Text="色相" Width="36" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="HueValue" Width="42" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <Slider x:Name="HueSlider" Minimum="-180" Maximum="180" Value="0" ValueChanged="ImageSlider_ValueChanged"/>
                </DockPanel>
                <Button Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource TextButton}" Content="恢复" Click="ResetImage_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,8,14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="00:00" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <Slider x:Name="TimeSlider" Grid.Column="1" Style="{StaticResource TimeSlider}" VerticalAlignment="Center" Margin="8,0"
                            PreviewMouseLeftButtonDown="TimeSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="TimeSlider_PreviewMouseLeftButtonUp"
                            ValueChanged="TimeSlider_ValueChanged"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="00:00" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Content="&#xE892;" Click="Previous_Click"/>
                        <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Margin="6,0" Click="Play_Click">
                            <TextBlock x:Name="PlayIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click"/>
                        <Button x:Name="StopButton" Style="{StaticResource IconButton}" Content="&#xE71A;" Margin="4,0,0,0" Click="Stop_Click"/>
                        <Button x:Name="FrameBackButton" Style="{StaticResource TextButton}" Content="上一帧" Margin="8,0,0,0" Click="FrameBack_Click"/>
                        <Button x:Name="FrameNextButton" Style="{StaticResource TextButton}" Content="下一帧" Margin="4,0,0,0" Click="FrameNext_Click"/>
                        <Button x:Name="SnapshotButton" Style="{StaticResource IconButton}" Content="&#xE114;" Margin="4,0,0,0" Click="Snapshot_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" Click="Mute_Click"/>
                        <Slider x:Name="VolumeSlider" Width="72" Margin="2,0,6,0" Minimum="0" Maximum="100" Style="{StaticResource TimeSlider}"
                                ValueChanged="VolumeSlider_ValueChanged" ToolTip="音量"/>
                        <ComboBox x:Name="SpeedBox" Style="{StaticResource DarkComboBox}" Width="72" Height="30" SelectionChanged="SpeedBox_SelectionChanged">
                            <ComboBoxItem Content="0.5x" Tag="0.5"/>
                            <ComboBoxItem Content="0.75x" Tag="0.75"/>
                            <ComboBoxItem Content="1.0x" Tag="1"/>
                            <ComboBoxItem Content="1.25x" Tag="1.25"/>
                            <ComboBoxItem Content="1.5x" Tag="1.5"/>
                            <ComboBoxItem Content="2.0x" Tag="2"/>
                        </ComboBox>
                        <Button x:Name="RepeatButton" Style="{StaticResource TextButton}" Margin="6,0,0,0" Click="Repeat_Click"/>
                        <Button x:Name="ImageButton" Style="{StaticResource TextButton}" Content="画面" Margin="4,0,0,0" Click="ToggleImage_Click"/>
                        <Button x:Name="FullScreenButton" Style="{StaticResource IconButton}" Margin="4,0,0,0" Content="&#xE740;" Click="Fullscreen_Click"/>
                        <Button x:Name="PlaylistButton" Style="{StaticResource IconButton}" Content="&#xE8FD;" Click="TogglePlaylist_Click" ToolTip="播放列表"/>
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" AutomationProperties.Name="设置"/>
                        <Button x:Name="MoreMenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="2,0,0,0" Click="More_Click" ToolTip="更多"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
