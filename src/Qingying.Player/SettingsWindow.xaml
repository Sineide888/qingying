<Window x:Class="Qingying.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="640"
        Height="560"
        MinWidth="560"
        MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg0}"
        Foreground="{StaticResource Text}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="Transparent">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C2330"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#2C3444"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="#3A2A1C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Bg0}" BorderBrush="#2C3444" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="{StaticResource Bg1}">
                <TextBlock Text="设置" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Cancel_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭"/>
            </Grid>
            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TabControl>
                    <TabItem Header="快捷键">
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="点选右侧按键，再按下新的组合键。Esc 取消这次修改。"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ShortcutList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="截图">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="截图保存到" Foreground="{StaticResource Muted}"/>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource TextButton}" Content="浏览" Click="BrowseFolder_Click"/>
                                <TextBox x:Name="SnapshotFolderBox" Height="32" VerticalContentAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="播放或暂停时按 F12，或点底部的相机按钮。画面会存成 PNG。"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Style="{StaticResource TextButton}" Content="恢复默认快捷键" Click="ResetShortcuts_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource TextButton}" Content="取消" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource TextButton}" Content="确定" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
